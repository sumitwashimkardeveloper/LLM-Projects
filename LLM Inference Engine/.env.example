MODELS_MANIFEST=models.json
MAX_LOADED_MODELS=1

# Single-model fallback: only used if MODELS_MANIFEST doesn't exist.
# MODEL_PATH=./models/your-model.Q4_K_M.gguf
# MODEL_NAME=llama-3-8b-instruct
# MODEL_FAMILY=auto

# GGUF defaults
N_CTX=4096
N_GPU_LAYERS=0
# N_THREADS=8
N_PARALLEL=2

# AWQ backend (GPU-only)
AWQ_DEVICE=cuda:0
AWQ_DTYPE=float16

# Concurrency and backpressure
MAX_QUEUE_DEPTH=64
REQUEST_TIMEOUT_S=120

# Authentication (comma-separated keys; empty to disable)
# API_KEYS=key1,key2,key3

# Rate limiting (requests per minute; 0 to disable)
# RATE_LIMIT_RPM=100

HOST=0.0.0.0
PORT=8000
