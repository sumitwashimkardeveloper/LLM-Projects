# Multi-model setup (recommended): copy models.json.example to models.json
# and list your GGUF models there. MODELS_MANIFEST points at that file.
MODELS_MANIFEST=models.json
MAX_LOADED_MODELS=1

# Single-model fallback: only used if MODELS_MANIFEST doesn't exist.
# MODEL_PATH=./models/your-model.Q4_K_M.gguf
# MODEL_NAME=llama-3-8b-instruct
# MODEL_FAMILY=auto

# Defaults applied to any model that doesn't override them
N_CTX=4096
N_GPU_LAYERS=0
# N_THREADS=8
N_PARALLEL=2

MAX_QUEUE_DEPTH=64
REQUEST_TIMEOUT_S=120

HOST=0.0.0.0
PORT=8000
